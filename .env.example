# Flask session secret (use a long random string in production)
SECRET_KEY=change-me-to-a-long-random-string

# Gmail SMTP for dashboard 2FA + CLI alerts (use a Google App Password)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# CLI email settings (can match MAIL_* above)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
RECIPIENT_EMAIL=your-email@gmail.com

# Optional Wazuh API (leave blank to skip live Wazuh)
WAZUH_API=https://localhost:55000
WAZUH_USER=wazuh
WAZUH_PASS=

# Containment honesty controls
# simulated = local SQLite block list only (default)
# dry_run   = audit log only, no list changes
# stub      = optional HTTP POST to CONTAINMENT_STUB_URL, then local SQLite
CONTAINMENT_MODE=simulated
CONTAINMENT_STUB_URL=

# Auto-containment: require ML max(predict_proba) >= this when ML is used
# (rules-critical may still contain without ML agreement)
ML_CONFIDENCE_THRESHOLD=0.70

# SQLite database (source of truth for triage + containment)
# Default: data/soc_assistant.db
SOC_DB_PATH=data/soc_assistant.db

