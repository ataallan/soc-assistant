# Flask session secret (use a long random string in production)
SECRET_KEY=change-me-to-a-long-random-string

# Gmail SMTP for dashboard 2FA + CLI alerts (use a Google App Password)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# CLI email settings (can match MAIL_* above)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
RECIPIENT_EMAIL=your-email@gmail.com

# Optional Wazuh API (leave blank to skip live Wazuh)
WAZUH_API=https://localhost:55000
WAZUH_USER=wazuh
WAZUH_PASS=
