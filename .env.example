# Flask session secret (use a long random string in production)
SECRET_KEY=change-me-to-a-long-random-string

# Comma-separated admin login emails (case-insensitive). Everyone else is analyst.
SOC_ADMIN_EMAILS=your-admin@email.com

# Optional analyst roster for case assignee dropdown (comma-separated)
SOC_ANALYST_EMAILS=analyst1@email.com,analyst2@email.com

# Set true when serving the dashboard over HTTPS so the session cookie is Secure.
# SESSION_COOKIE_SECURE=true

# Gmail SMTP for dashboard 2FA + CLI alerts (use a Google App Password)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# CLI email settings (can match MAIL_* above)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
RECIPIENT_EMAIL=your-email@gmail.com

# Optional Wazuh Manager API (leave blank to skip live Manager auth)
WAZUH_API=https://localhost:55000
WAZUH_USER=wazuh
WAZUH_PASS=

# Wazuh Indexer (OpenSearch) — preferred alert source (wazuh-alerts-*)
# On Windows where the indexer binds 127.0.0.1 inside WSL only, set VIA_WSL=true
WAZUH_INDEXER_URL=https://127.0.0.1:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASS=
WAZUH_INDEXER_INDEX=wazuh-alerts*
WAZUH_INDEXER_VIA_WSL=false


# Containment honesty controls (see docs/CONTAINMENT.md)
# simulated = local SQLite block list only (default, one-click)
# dry_run   = audit log only, no list changes (UI: Preview mode)
# stub|live = admin preview → confirm; optional HTTP POST then SQLite
CONTAINMENT_MODE=simulated
CONTAINMENT_STUB_URL=
# Optional Bearer token for stub/live (never logged)
# CONTAINMENT_STUB_TOKEN=

# Auto-containment: require ML max(predict_proba) >= this when ML is used
# (rules-critical may still contain without ML agreement)
ML_CONFIDENCE_THRESHOLD=0.70

# Honest ML mode: when true (default), rules severity is primary; ML is assist-only
# and never overrides the operator-facing severity label.
ML_ASSIST_ONLY=true

# Storage (source of truth for triage + containment)
# Default backend: SQLite — works with no extra services
SOC_DB_PATH=data/soc_assistant.db

# Optional PostgreSQL (when set, overrides SQLite). Prefer SOC_DATABASE_URL.
# Example: postgresql+psycopg://soc:soc@localhost:5432/soc_assistant
# SOC_DATABASE_URL=
# DATABASE_URL=

# Detection Phase A enrichment (offline-first; default true)
ENRICHMENT_ENABLED=true
# Optional AbuseIPDB key — leave blank to skip external lookups
# ABUSEIPDB_API_KEY=

# Case SLA hours (severity → due_at from create time)
# SLA_HOURS_CRITICAL=4
# SLA_HOURS_HIGH=8
# SLA_HOURS_MEDIUM=24
# SLA_HOURS_LOW=72

# External ticket sync for cases (see docs/CASES.md)
# simulated = local synthetic ticket id (default)
# stub|jira = optional HTTP POST then store external_* fields
CASE_SYNC_MODE=simulated
CASE_SYNC_STUB_URL=
# Optional Bearer token for stub/jira (never logged)
# CASE_SYNC_STUB_TOKEN=
# JIRA_BASE_URL=https://your-org.atlassian.net
# JIRA_API_TOKEN=

# Optional path to allowlists YAML (default: config/allowlists.yml)
# ALLOWLIST_PATH=config/allowlists.yml
